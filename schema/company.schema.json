{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "industry": {
      "type": "string",
      "minLength": 1
    },
    "hqCountry": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.(png|jpg|gif|webp|svg|ico)$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "headcount": {
            "type": "integer",
            "exclusiveMinimum": 100,
            "maximum": 9007199254740991
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "cost_cutting",
              "restructuring",
              "ai_automation",
              "market_downturn",
              "acquisition",
              "other"
            ]
          },
          "dataset": {
            "type": "string",
            "enum": [
              "ai-layoffs-index",
              "curated"
            ]
          },
          "externalId": {
            "type": "string",
            "pattern": "^[a-z-]+:[0-9a-f]+$"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "format": "uri"
                },
                "siteName": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "date",
          "headcount",
          "country",
          "reason",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "events"
  ],
  "additionalProperties": false
}
