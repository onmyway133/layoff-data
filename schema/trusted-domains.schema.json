{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "region": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "domain",
      "label"
    ],
    "additionalProperties": false
  }
}
